---
import Base from '../../layouts/Base.astro';
import { news, fmtDate, BASE } from '../../lib/resolve';

export async function getStaticPaths() {
  const { news: ns } = await import('../../lib/resolve');
  return ns
    .filter((n: any) => n.status === 'Published')
    .map((n: any) => ({ params: { slug: n.slug }, props: { item: n } }));
}

const { item } = Astro.props as { item: typeof news[number] };
---
<Base title={`${item.title} — SWEN`} description={item.excerpt}>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-20">
    <a href={`${BASE}/news`} class="text-xs text-ink-mute hover:text-ink">← All news</a>
    <div class="mt-8 mb-6 flex items-center gap-4 flex-wrap">
      {item.category && <span class="chip bg-cream text-ink-soft">{item.category}</span>}
      <span class="text-sm text-ink-mute">{fmtDate(item.date)}</span>
    </div>
    <h1 class="display text-5xl mb-6">{item.title}</h1>
    {item.excerpt && <p class="text-xl font-serif text-ink-soft mb-10 leading-snug">{item.excerpt}</p>}
    {item.bodyHtml && <div class="news-body" set:html={item.bodyHtml} />}
  </article>
</Base>

<!-- is:global because set:html content doesn't get Astro's scoped attributes -->
<style is:global>
  .news-body {
    @apply text-ink-soft leading-relaxed;
  }
  .news-body > * + * {
    @apply mt-5;
  }
  .news-body h2 { @apply text-3xl mt-12 mb-2 text-ink; }
  .news-body h3 { @apply text-2xl mt-10 mb-2 text-ink; }
  .news-body h4 { @apply text-xl mt-8 mb-2 text-ink; }
  .news-body a { @apply underline underline-offset-2 decoration-ink-mute hover:text-ink; }
  .news-body strong { @apply font-semibold text-ink; }
  .news-body ul { @apply list-disc pl-6 space-y-1.5; }
  .news-body ol { @apply list-decimal pl-6 space-y-1.5; }
  .news-body blockquote { @apply border-l-2 border-rule pl-5 font-serif italic; }
  .news-body .callout { @apply bg-cream rounded-lg px-5 py-4 text-sm; }
  .news-body hr { @apply border-rule my-10; }
  .news-body pre { @apply bg-cream rounded-lg px-5 py-4 text-sm overflow-x-auto; }
  .news-body code { @apply font-mono text-sm; }
  .news-body figure img { @apply rounded-lg w-full; }
  .news-body figcaption { @apply text-xs text-ink-mute mt-2 text-center; }
  .news-body table { @apply w-full text-sm border-collapse; }
  .news-body th { @apply text-left font-semibold text-ink border-b border-rule px-3 py-2; }
  .news-body td { @apply border-b border-rule px-3 py-2 align-top; }
  .news-body details summary { @apply cursor-pointer font-semibold text-ink; }
</style>
