---
import Base from '../../layouts/Base.astro';
import { news, fmtDate, BASE } from '../../lib/resolve';

const published = news.filter((n) => n.status === 'Published');
---
<Base title="News — SWEN" description="Latest news from the SWEN group: papers, events, awards, PhD milestones.">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="smallcaps mb-6">News</p>
    <h1 class="display text-5xl mb-4">What's happening at SWEN</h1>
    <p class="text-ink-soft max-w-2xl">Papers, events, awards, and PhD updates from the group.</p>
  </section>

  {published.length === 0 ? (
    <section class="max-w-5xl mx-auto px-6 pb-20">
      <div class="p-10 rounded-2xl bg-cream text-center">
        <p class="text-ink-soft">No news yet — stay tuned.</p>
      </div>
    </section>
  ) : (
    <section class="max-w-5xl mx-auto px-6 pb-20 border-t border-rule">
      {published.map((n) => (
        <a href={`${BASE}/news/${n.slug}`} class="block py-8 border-b border-rule grid md:grid-cols-[120px_1fr] gap-6 hover:bg-cream px-4 -mx-4">
          <div class="smallcaps text-ink-mute">{fmtDate(n.date)}</div>
          <div>
            {n.category && <p class="smallcaps text-brand-magenta mb-2">{n.category}</p>}
            <h2 class="font-serif text-2xl mb-2 leading-snug">{n.title}</h2>
            {n.excerpt && <p class="text-sm text-ink-soft leading-relaxed">{n.excerpt}</p>}
          </div>
        </a>
      ))}
    </section>
  )}
</Base>
