---
import Base from '../../layouts/Base.astro';
import { talks, labs, labAccent, fmtDate, BASE, talkIsExternal } from '../../lib/resolve';

const externalCount = talks.filter((t) => talkIsExternal(t)).length;
const internalCount = talks.filter((t) => !talkIsExternal(t)).length;
---
<Base title="SWEN Talks" description="The SWEN seminar series — monthly research talks by SWEN members and invited speakers.">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <p class="smallcaps mb-6">SWEN Talks</p>
    <h1 class="display text-5xl mb-4">Our research seminar series.</h1>
    <p class="text-lg text-ink-soft max-w-2xl leading-relaxed">
      Monthly seminar hosting SWEN members and invited speakers from academia and industry.
      Talks are held in the Sala Seminari Alan Turing (DISIM, 3rd floor, UnivAQ).
      Open to students, researchers, and practitioners.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-10">
    <div class="grid grid-cols-3 gap-0 border-y border-rule py-6">
      <div>
        <div class="display text-4xl">{talks.length}</div>
        <div class="smallcaps mt-2">Talks</div>
      </div>
      <div>
        <div class="display text-4xl">{externalCount}</div>
        <div class="smallcaps mt-2">External Speakers</div>
      </div>
      <div>
        <div class="display text-4xl">{internalCount}</div>
        <div class="smallcaps mt-2">SWEN Members</div>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-20">
    <ul class="border-t border-rule">
      {talks.map((t) => {
        const relatedLab = t.relatedLabIds.length > 0 ? labs.find((l) => l.id === t.relatedLabIds[0]) : null;
        const a = relatedLab ? labAccent(relatedLab.name) : { bar: '#44546b', chipBg: '#f5f3ef', chipFg: '#44546b' };
        const isExternal = talkIsExternal(t);
        return (
          <li class="py-7 border-b border-rule grid md:grid-cols-[140px_1fr_140px] gap-6">
            <div>
              <p class="smallcaps text-ink-mute">{fmtDate(t.date)}</p>
              {(t.timeStart || t.timeEnd) && <p class="text-xs text-ink-mute mt-1 font-mono">{t.timeStart}{t.timeEnd ? `–${t.timeEnd}` : ''}</p>}
            </div>
            <div>
              {relatedLab && <p class="smallcaps mb-2" style={`color: ${a.chipFg};`}>{relatedLab.name} topic</p>}
              <h2 class="font-serif text-xl mb-2 leading-snug">
                <a href={`${BASE}/talks/${t.slug}`} class="hover:text-brand-magenta">{t.title}</a>
              </h2>
              <p class="text-sm text-ink-mute mb-3">
                <strong class="text-ink">{t.speaker}</strong>{t.affiliation ? ` · ${t.affiliation}` : ''}
              </p>
              {t.abstract && (
                <p class="text-sm text-ink-soft leading-relaxed">
                  {t.abstract.length > 260 ? `${t.abstract.slice(0, 260)}…` : t.abstract}
                </p>
              )}
              <a href={`${BASE}/talks/${t.slug}`} class="inline-block mt-3 text-sm font-medium text-brand-magenta hover:underline">
                Read full talk →
              </a>
            </div>
            <div class="text-xs text-ink-mute md:text-right">
              {t.location && <p>{t.location}</p>}
              <p class="mt-3 chip" style={isExternal ? `background: ${a.chipBg}; color: ${a.chipFg};` : 'background: #f5f3ef; color: #44546b;'}>
                {isExternal ? 'External' : 'Internal'}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="bg-cream border-y border-rule">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <p class="smallcaps mb-4">Propose a talk</p>
      <h2 class="display text-3xl mb-4">Interested in presenting at SWEN Talks?</h2>
      <p class="text-ink-soft leading-relaxed">
        We welcome proposals from researchers and practitioners working on software engineering, model-driven development,
        performance, software architecture, AI for SE, and adjacent areas.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <a href="mailto:alfonso.pierantonio@univaq.it?subject=SWEN%20Talk%20proposal" class="inline-flex items-center gap-2 font-medium text-brand-magenta hover:underline">
          Email the coordinator ↗
        </a>
        <a href={`${BASE}/contact`} class="text-ink-mute hover:text-ink">More ways to get in touch →</a>
      </div>
    </div>
  </section>
</Base>
