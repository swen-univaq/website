---
import Base from '../../layouts/Base.astro';
import { teaching, personById } from '../../lib/resolve';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const courses = teaching.filter((t: any) => t.type === 'Course');

const levels = ['BSc', 'MSc', 'PhD'];
const grouped = levels
  .map((level) => ({
    level,
    items: courses.filter((c: any) => c.level === level),
  }))
  .filter((g) => g.items.length > 0);
const other = courses.filter((c: any) => !levels.includes(c.level));

function instructorName(c: any): string | null {
  if (c.instructorIds?.length > 0) {
    const names = c.instructorIds
      .map((id: string) => personById(id)?.name)
      .filter(Boolean);
    if (names.length > 0) return names.join(', ');
  }
  return c.instructorText || null;
}

const levelLabel: Record<string, string> = {
  BSc: 'Bachelor courses',
  MSc: 'Master courses',
  PhD: 'PhD courses',
};
---
<Base title="Teaching — SWEN" description="Courses taught by SWEN members at the University of L'Aquila: software engineering, model-driven development, software architecture, and more.">

  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <p class="smallcaps mb-6">Teaching</p>
    <h1 class="display text-5xl mb-4">What we teach.</h1>
    <p class="text-lg text-ink-soft max-w-2xl leading-relaxed">
      SWEN members teach software engineering across the BSc, MSc, and PhD programs of the
      University of L'Aquila — from foundations of programming and software design to
      model-driven engineering, software architecture, and performance.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16 border-t border-rule pt-12">
    {courses.length === 0 ? (
      <div class="p-10 rounded-2xl bg-cream text-center">
        <h2 class="display text-3xl mb-3">Course list coming soon</h2>
        <p class="text-ink-soft max-w-xl mx-auto">
          We are compiling the full list of courses taught by SWEN members. In the meantime,
          see the <a href="https://www.disim.univaq.it" target="_blank" rel="noopener" class="underline hover:text-brand-magenta">DISIM course catalogue</a>.
        </p>
      </div>
    ) : (
      <div class="space-y-12">
        {grouped.map(({ level, items }) => (
          <div>
            <h2 class="display text-3xl mb-6">{levelLabel[level] ?? level}</h2>
            <ul class="border-t border-rule grid md:grid-cols-2 gap-x-12">
              {items.map((c: any) => {
                const instructor = instructorName(c);
                return (
                  <li class="py-5 border-b border-rule">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <h3 class="font-serif text-lg leading-snug">
                        {c.link ? (
                          <a href={c.link} target="_blank" rel="noopener" class="hover:text-brand-magenta hover:underline">{c.title} ↗</a>
                        ) : (
                          c.title
                        )}
                      </h3>
                      {c.academicYear && <span class="text-xs font-mono text-ink-mute">{c.academicYear}</span>}
                    </div>
                    {instructor && <p class="smallcaps text-brand-magenta mt-1">{instructor}</p>}
                    {c.description && <p class="text-sm text-ink-soft mt-2">{c.description}</p>}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
        {other.length > 0 && (
          <div>
            <h2 class="display text-3xl mb-6">Other courses</h2>
            <ul class="border-t border-rule grid md:grid-cols-2 gap-x-12">
              {other.map((c: any) => (
                <li class="py-5 border-b border-rule">
                  <h3 class="font-serif text-xl">{c.title}</h3>
                  {c.description && <p class="text-sm text-ink-soft mt-2 max-w-3xl">{c.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </section>

  <section class="bg-cream border-y border-rule">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <p class="smallcaps mb-4">Work with us</p>
      <h2 class="display text-3xl mb-6">Thesis topics & open positions</h2>
      <p class="text-ink-soft leading-relaxed mb-6">
        Looking for an MSc thesis topic, a PhD position, or a postdoc opening?
        We maintain an up-to-date list of opportunities to join the group.
      </p>
      <a href={`${base}/positions`} class="inline-block font-medium text-brand-magenta hover:underline">See open positions →</a>
    </div>
  </section>
</Base>
