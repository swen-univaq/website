---
import Base from '../layouts/Base.astro';
import { BASE } from '../lib/resolve';
---
<Base title="Not found — SWEN">
  <section class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="smallcaps mb-6">404</p>
    <h1 class="display text-6xl mb-6">Page not found.</h1>
    <p class="text-lg text-ink-soft mb-10">
      The page you requested doesn't exist, or has moved.
    </p>
    <a href={`${BASE}/`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-ink text-white text-sm font-medium hover:bg-brand-magenta transition-colors">
      Back to home
    </a>
  </section>
</Base>
