---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — SWEN" description="Contact the SWEN Research Group at DISIM, Università degli Studi dell'Aquila.">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-8">
    <p class="smallcaps mb-6">Contact</p>
    <h1 class="display text-5xl mb-4">Get in touch.</h1>
    <p class="text-lg text-ink-soft max-w-2xl leading-relaxed">
      Reach out for collaborations, PhD or postdoc enquiries, thesis topics, industrial partnerships,
      or to propose a SWEN Talk.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-12 border-t border-rule">
    <div>
      <h2 class="smallcaps mb-5">Address</h2>
      <p class="font-serif text-lg leading-snug mb-2">SWEN Research Group</p>
      <p class="text-ink-soft leading-relaxed">
        DISIM — Department of Information Engineering, Computer Science and Mathematics<br/>
        Università degli Studi dell'Aquila<br/>
        Via Vetoio — Building "Alan Turing"<br/>
        67100 L'Aquila, Italy
      </p>
    </div>
    <div>
      <h2 class="smallcaps mb-5">Contacts</h2>
      <ul class="space-y-4 text-sm">
        <li>
          <p class="text-xs text-ink-mute">Coordinator</p>
          <a href="mailto:alfonso.pierantonio@univaq.it" class="font-serif text-base hover:text-brand-magenta">
            alfonso.pierantonio@univaq.it
          </a>
        </li>
        <li>
          <p class="text-xs text-ink-mute">Department</p>
          <a href="https://www.disim.univaq.it/" target="_blank" rel="noopener" class="font-serif text-base hover:text-brand-magenta">
            disim.univaq.it ↗
          </a>
        </li>
        <li>
          <p class="text-xs text-ink-mute">LinkedIn</p>
          <span class="font-serif text-base">SWEN Research Group</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="bg-cream border-y border-rule">
    <div class="max-w-4xl mx-auto px-6 py-12">
      <h2 class="smallcaps mb-5">Propose a SWEN Talk</h2>
      <p class="text-ink-soft leading-relaxed">
        Researchers interested in presenting at our seminar series can write to the coordinator with
        a title, a brief abstract (~200 words), and a short bio. External speakers are particularly welcome.
      </p>
    </div>
  </section>
</Base>
