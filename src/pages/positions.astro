---
import Base from '../layouts/Base.astro';
import { teaching } from '../lib/resolve';

const openPositions = teaching.filter((t: any) =>
  (t.type === 'PhD position' || t.type === 'Postdoc position') && t.status === 'Open',
);
const openTheses = teaching.filter((t: any) => t.type === 'Thesis topic' && t.status === 'Open');
---
<Base title="Open Positions — SWEN" description="PhD positions, postdoc openings, and thesis topics at the SWEN group.">

  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <p class="smallcaps mb-6">Open Positions</p>
    <h1 class="display text-5xl mb-4">Join SWEN.</h1>
    <p class="text-lg text-ink-soft max-w-2xl leading-relaxed">
      We welcome PhD students, postdocs, and visiting researchers working on software engineering,
      model-driven development, performance, software architecture, and AI for SE.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16 border-t border-rule pt-12">
    {openPositions.length === 0 && openTheses.length === 0 ? (
      <div class="p-10 rounded-2xl bg-cream text-center">
        <h2 class="display text-3xl mb-3">No current openings</h2>
        <p class="text-ink-soft max-w-xl mx-auto">
          We don't have active positions at the moment. New openings (PhD, postdoc, research fellow)
          are announced on our LinkedIn page and listed here. Prospective candidates are welcome to
          reach out to the coordinator.
        </p>
      </div>
    ) : (
      <div class="space-y-10">
        {openPositions.length > 0 && (
          <div>
            <h2 class="display text-3xl mb-6">Open positions</h2>
            <ul class="border-t border-rule">
              {openPositions.map((p: any) => (
                <li class="py-5 border-b border-rule">
                  <p class="smallcaps text-brand-magenta">{p.type}</p>
                  <h3 class="font-serif text-xl mt-1">{p.title}</h3>
                  {p.description && <p class="text-sm text-ink-soft mt-2">{p.description}</p>}
                  {p.deadline && <p class="text-xs text-ink-mute mt-2">Deadline: {p.deadline}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
        {openTheses.length > 0 && (
          <div>
            <h2 class="display text-3xl mb-6">Thesis topics</h2>
            <ul class="border-t border-rule">
              {openTheses.map((t: any) => (
                <li class="py-5 border-b border-rule">
                  <p class="smallcaps text-brand-orange">{t.level} Thesis</p>
                  <h3 class="font-serif text-xl mt-1">{t.title}</h3>
                  {t.description && <p class="text-sm text-ink-soft mt-2">{t.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </section>

  <section class="border-y border-rule" style="background: linear-gradient(135deg, rgba(154,26,90,0.05), rgba(252,181,26,0.05));">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="smallcaps mb-4">Why L'Aquila</p>
      <h2 class="display text-4xl mb-8">A vibrant intellectual hub in the heart of the Apennines.</h2>
      <div class="grid md:grid-cols-2 gap-10 text-ink-soft leading-relaxed">
        <p>
          L'Aquila is a city of rich history, cultural heritage, and striking natural beauty. Surrounded by the
          Apennine mountains, it combines academic excellence with extraordinary landscapes. Home to the University
          of L'Aquila, the Gran Sasso Science Institute, the Fine Arts Academy, and the Conservatorio — a hub for
          education, research, and the arts.
        </p>
        <p>
          Nearby are the Istituto Nazionale di Fisica Nucleare and the Laboratori del Gran Sasso, two of the world's
          leading research centers in physics. The city's dynamic intellectual environment is enriched by natural
          surroundings: picturesque villages, expansive national parks, and world-class ski resorts.
        </p>
      </div>
      <div class="mt-10 pt-6 border-t border-rule text-sm flex items-center justify-between flex-wrap gap-3">
        <p class="text-ink-mute">L'Aquila · Italian Capital of Culture 2026</p>
        <a href="https://capitalidellacultura.cultura.gov.it/laquila-capitale-italiana-della-cultura-2026/" target="_blank" rel="noopener" class="text-brand-magenta hover:underline">
          capitalidellacultura.cultura.gov.it ↗
        </a>
      </div>
    </div>
  </section>
</Base>
