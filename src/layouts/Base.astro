---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'SWEN — Software Engineering Research Group',
  description = 'SWEN is the Software Engineering Research Group at DISIM, Università degli Studi dell\'Aquila — 4 labs, 36 researchers, active PNRR, PRIN and Horizon Europe grants.',
  ogImage = 'website-logo.png',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? '';
const fullTitle = title.includes('SWEN') ? title : `${title} · SWEN`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}website-logo.png`} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${import.meta.env.BASE_URL}${ogImage}`} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
  </head>
  <body class="antialiased">
    <Topbar />
    <main><slot /></main>
    <Footer />
  </body>
</html>
